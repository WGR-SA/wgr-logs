// Grafana Alloy — host-level log collector for the wgr-logs VPS.
// Reads systemd journal + nginx access/error logs and ships to Loki.

logging {
  level  = "info"
  format = "logfmt"
}

discovery.relabel "systemd" {
  targets = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "systemd" {
  max_age       = "12h"
  path          = "/run/log/journal"
  relabel_rules = discovery.relabel.systemd.rules
  forward_to    = [loki.write.default.receiver]
  labels        = {
    job = "systemd-journal",
    env = "prod",
  }
}

loki.source.file "nginx_access" {
  targets = [
    {
      __path__ = "/var/log/nginx/access.log",
      app      = "nginx",
      env      = "prod",
      stream   = "access",
    },
  ]
  forward_to = [loki.write.default.receiver]
}

loki.source.file "nginx_error" {
  targets = [
    {
      __path__ = "/var/log/nginx/error.log",
      app      = "nginx",
      env      = "prod",
      stream   = "error",
      level    = "error",
    },
  ]
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = {
    cluster = "wgr-prod",
  }
}
