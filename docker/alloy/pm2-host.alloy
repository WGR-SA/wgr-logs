// Grafana Alloy — host-level shipper for PM2 logs.
// Deploy on a server running PM2 to tail ~/.pm2/logs/*.log and ship to wgr-logs.
//
// Reads:
//   /home/*/.pm2/logs/<app>-(out|error).log
// Labels emitted:
//   app=<pm2 process name>, env=prod, host=<hostname>, stream=out|error, level=info|error
//
// Requires environment variable WGR_INGEST_TOKEN (set via /etc/alloy/.env).

logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "pm2" {
  path_targets = [
    {
      __path__ = "/home/*/.pm2/logs/*.log",
      env      = "prod",
      host     = constants.hostname,
      source   = "pm2",
    },
  ]
}

loki.process "pm2" {
  forward_to = [loki.write.wgr.receiver]

  // Extract app name + stream type from filename: /.../<app>-(out|error).log
  stage.regex {
    expression = ".*/(?P<app>.+)-(?P<stream>out|error)\\.log$"
    source     = "filename"
  }

  stage.labels {
    values = {
      app    = "",
      stream = "",
    }
  }

  // Default level by stream
  stage.match {
    selector = "{stream=\"error\"}"
    stage.static_labels {
      values = { level = "error" }
    }
  }
  stage.match {
    selector = "{stream=\"out\"}"
    stage.static_labels {
      values = { level = "info" }
    }
  }

  // Best-effort: if the line is JSON, try to lift its `level` field.
  // Apps logging via pino/winston will get accurate levels.
  stage.json {
    expressions = {
      json_level = "level",
    }
  }
  stage.labels {
    values = { level = "json_level" }
  }
}

loki.source.file "pm2" {
  targets    = local.file_match.pm2.targets
  forward_to = [loki.process.pm2.receiver]
  tail_from_end = false
}

loki.write "wgr" {
  endpoint {
    url = "https://<INGEST_DOMAIN>/loki/api/v1/push"
    basic_auth {
      username = "wgr"
      password = sys.env("WGR_INGEST_TOKEN")
    }
  }
  external_labels = {
    cluster = "wgr-prod",
  }
}
