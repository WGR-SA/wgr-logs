// Grafana Alloy — multi-app CakePHP shipper.
// Auto-discovers any /<CAKE_BASE_DIR>/<app>/logs/*.log and labels logs by app.
//
// Path layout assumption:
//   <CAKE_BASE_DIR>/<app_slug>/logs/<log_type>.log
//   e.g. /var/www/cab-data/logs/error.log
//        /var/www/ofrou-cms/logs/debug.log
//
// Labels emitted:
//   app=<extracted from path>, env=prod, host=<hostname>, log_type=error|debug|...,
//   level=<extracted from JSON if present, fallback per log_type>
//
// Required env vars (set via /etc/alloy/.env):
//   - WGR_INGEST_TOKEN
//   - CAKE_BASE_DIR     (e.g. "/var/www")
//   - CAKE_ENV          (optional, defaults to "prod")
//
// Optional: if you need to cover multiple base dirs (e.g. /var/www AND /srv/apps),
//   duplicate the local.file_match + loki.source.file blocks with distinct names.

logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "cake" {
  path_targets = [
    {
      __path__ = sys.env("CAKE_BASE_DIR") + "/*/logs/*.log",
      env      = coalesce(sys.env("CAKE_ENV"), "prod"),
      host     = constants.hostname,
      source   = "cakephp",
    },
  ]
}

loki.process "cake" {
  forward_to = [loki.write.wgr.receiver]

  // Extract app name + log type from path
  // Matches: <anything>/<app_slug>/logs/<log_type>.log
  stage.regex {
    expression = ".*/(?P<app>[^/]+)/logs/(?P<log_type>[a-z][a-z0-9-]*)\\.log$"
    source     = "filename"
  }

  stage.labels {
    values = {
      app      = "",
      log_type = "",
    }
  }

  // Try JSON parse (when CakePHP uses JsonFormatter)
  stage.json {
    expressions = {
      json_level   = "level",
      json_message = "message",
    }
  }
  stage.labels {
    values = { level = "json_level" }
  }

  // Fallback: derive level from log_type if JSON didn't yield one
  stage.match {
    selector = "{level=\"\", log_type=\"error\"}"
    stage.static_labels {
      values = { level = "error" }
    }
  }
  stage.match {
    selector = "{level=\"\", log_type=\"cli-error\"}"
    stage.static_labels {
      values = { level = "error" }
    }
  }
  stage.match {
    selector = "{level=\"\", log_type=\"debug\"}"
    stage.static_labels {
      values = { level = "debug" }
    }
  }
  stage.match {
    selector = "{level=\"\", log_type=\"queries\"}"
    stage.static_labels {
      values = { level = "info" }
    }
  }
}

loki.source.file "cake" {
  targets       = local.file_match.cake.targets
  forward_to    = [loki.process.cake.receiver]
  tail_from_end = false
}

loki.write "wgr" {
  endpoint {
    url = "https://<INGEST_DOMAIN>/loki/api/v1/push"
    basic_auth {
      username = "wgr"
      password = sys.env("WGR_INGEST_TOKEN")
    }
  }
  external_labels = {
    cluster = "wgr-prod",
  }
}
