# --- Domains served by Traefik ---
# Grafana UI (read/dashboards)
LOGS_DOMAIN=<LOGS_DOMAIN>
# Loki ingestion endpoint (push from Docker driver, Alloy, CF Workers)
INGEST_DOMAIN=<INGEST_DOMAIN>
# Management API (shipper polling + admin UI) — Phase B
API_DOMAIN=<API_DOMAIN>
# Email used by Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.com

# --- Loki backend (Infomaniak Swiss Backup S3) ---
# Endpoint without protocol, e.g. s3.pub1.infomaniak.cloud
S3_ENDPOINT=s3.pub1.infomaniak.cloud
S3_REGION=us-east-1
S3_BUCKET_CHUNKS=wgr-logs-chunks
S3_BUCKET_RULER=wgr-logs-ruler
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_me_with_a_strong_password
# Public URL injected in alert links etc.
GRAFANA_ROOT_URL=https://<LOGS_DOMAIN>

# --- Ingest auth (Bearer token shared with all shippers) ---
INGEST_AUTH_TOKEN=replace_me_with_a_random_64_hex_string

# --- Alerting: Slack incoming webhook ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_CHANNEL=#wgr-alerts

# --- Management API (Phase B) ---
# Postgres for storing agents/sources/config-versions
PG_DATABASE_NAME=wgr_logs
PG_DATABASE_USER=wgrlogs
PG_DATABASE_PASSWORD=replace_with_openssl_rand_base64_32
# Bearer token for admin endpoints (desktop UI uses this)
WGR_API_ADMIN_TOKEN=replace_with_openssl_rand_hex_32
# Bearer token allowing shippers to register themselves (give to operators when deploying a new agent)
WGR_API_REGISTER_TOKEN=replace_with_openssl_rand_hex_32
