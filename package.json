{
  "name": "wgr-logs",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:client": "npm run build -w @wgr/logs-client",
    "start:agent": "npm run start -w @wgr/wgr-logs-agent",
    "build:agent": "npm run build -w @wgr/wgr-logs-agent",
    "test:agent": "npm run test -w @wgr/wgr-logs-agent",
    "build:medic": "npm run build -w @wgr/wgr-logs-medic",
    "test:medic": "npm run test -w @wgr/wgr-logs-medic",
    "start:medic": "npm run start -w @wgr/wgr-logs-medic",
    "dev:desk": "npm run dev -w @wgr/wgr-logs-desk",
    "build:desk": "npm run build -w @wgr/wgr-logs-desk",
    "tauri:dev:desk": "npm run tauri:dev -w @wgr/wgr-logs-desk",
    "tauri:build:desk": "npm run tauri:build -w @wgr/wgr-logs-desk",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "stack:ps": "docker compose ps",
    "deploy:stack": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
